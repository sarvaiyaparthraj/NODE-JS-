<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Edit Employee</title><style>body{font-family:Arial;background:#f5f6fa;margin:40px}.box{max-width:600px;background:#fff;padding:25px;margin:auto;border-radius:10px}label{display:block;margin-top:12px}input{width:100%;box-sizing:border-box;padding:10px;margin-top:5px}button,a{margin-top:18px;padding:10px 15px;border:0;border-radius:6px;background:#2563eb;color:#fff;text-decoration:none;display:inline-block}.error{color:#b91c1c}</style></head><body><div class="box"><h1>Edit Employee</h1><% if(error){ %><p class="error"><%= error %></p><% } %><form method="POST" action="/employees/edit/<%= employee._id %>"><label>Name<input name="name" value="<%= employee.name||'' %>" required></label><label>Email<input type="email" name="email" value="<%= employee.email||'' %>" required></label><label>Phone<input name="phone" value="<%= employee.phone||'' %>" required></label><label>Department<input name="department" value="<%= employee.department||'' %>" required></label><label>Designation<input name="designation" value="<%= employee.designation||'' %>" required></label><label>Salary<input type="number" min="0" name="salary" value="<%= employee.salary||'' %>" required></label><button type="submit">Update</button> <a href="/">Cancel</a></form></div></body></html>
