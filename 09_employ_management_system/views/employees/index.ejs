<!DOCTYPE html>
<html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Employees</title><style>body{font-family:Arial;margin:40px;background:#f5f6fa}a,button{padding:9px 13px;border:0;border-radius:6px;text-decoration:none;background:#2563eb;color:#fff;cursor:pointer}table{width:100%;border-collapse:collapse;background:#fff;margin-top:20px}th,td{padding:12px;border-bottom:1px solid #ddd;text-align:left}.danger{background:#dc2626}.actions{display:flex;gap:8px}</style></head><body><h1>Employee Management System</h1><a href="/employees/add">+ Add Employee</a><table><thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Department</th><th>Designation</th><th>Salary</th><th>Actions</th></tr></thead><tbody><% if (!employees.length) { %><tr><td colspan="7">No employees found.</td></tr><% } %><% employees.forEach(employee => { %><tr><td><%= employee.name %></td><td><%= employee.email %></td><td><%= employee.phone %></td><td><%= employee.department %></td><td><%= employee.designation %></td><td><%= employee.salary %></td><td class="actions"><a href="/employees/edit/<%= employee._id %>">Edit</a><form method="POST" action="/employees/delete/<%= employee._id %>" onsubmit="return confirm('Delete this employee?')"><button class="danger">Delete</button></form></td></tr><% }) %></tbody></table></body></html>
